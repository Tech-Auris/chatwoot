<div class="space-y-3">
  <% field.integrations.each do |integration| %>
    <div>
      <%= link_to integration.erp_source.name, edit_super_admin_account_integration_path(integration) %>
      <span class="text-sm text-n-slate-11">
        · <%= integration.active? ? 'in use (account ERP)' : 'not in use' %>
      </span>
      <%= render 'fields/integration_config_field/show', field: IntegrationConfigField.new(:config, integration.config, :show, resource: integration) %>
    </div>
  <% end %>
  <%= link_to 'Add integration', new_super_admin_account_integration_path(account_id: field.resource.id), class: 'button' %>
</div>

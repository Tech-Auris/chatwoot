<% if field.data.nil? %>
  <span class="text-sm text-slate-500">Não migrada (o n8n ainda lê do Supabase)</span>
<% else %>
  <dl class="grid grid-cols-[max-content_1fr] gap-x-4 gap-y-1 text-sm text-n-slate-12">
    <% Account::AI_CONFIG_FIELDS.each_key do |key| %>
      <dt class="text-slate-500"><%= key %></dt>
      <dd class="whitespace-pre-wrap"><%= field.value(key).nil? ? '—' : field.value(key) %></dd>
    <% end %>
  </dl>
<% end %>

<div class="space-y-3">
  <% field.prompts.each do |prompt| %>
    <div>
      <%= link_to prompt.name, edit_super_admin_account_prompt_path(prompt) %>
      <span class="text-sm text-n-slate-11">
        · <%= prompt.general? ? 'all other inboxes' : InboxIdsField.new(:inbox_ids, prompt.inbox_ids, :show).to_s %>
      </span>
      <div class="text-sm text-n-slate-11"><%= prompt.ai_prompt_system_message.truncate(160) %></div>
    </div>
  <% end %>
  <%= link_to 'Add prompt', new_super_admin_account_prompt_path(account_id: field.resource.id), class: 'button' %>
</div>

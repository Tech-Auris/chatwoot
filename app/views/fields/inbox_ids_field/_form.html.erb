<div class="field-unit__label self-start pt-2">
  <%= f.label field.attribute %>
</div>
<div class="field-unit__field">
  <%= f.select field.attribute, grouped_options_for_select(field.grouped_options, field.data), {}, multiple: true, size: 10 %>
  <p class="text-sm text-n-slate-11 mt-1">No inbox selected = the general prompt, used by every inbox that isn't in a specific prompt.</p>
</div>

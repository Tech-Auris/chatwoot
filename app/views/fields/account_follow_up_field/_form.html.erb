<div class="field-unit__label">
  <%= f.label :follow_up, 'Follow-up' %>
</div>
<div class="field-unit__field flex flex-col gap-4 p-4 bg-white rounded-lg shadow-sm outline outline-1 outline-n-container">
  <div>
    <p class="text-sm text-slate-600 mb-2">Minutos de espera antes de cada FUP, contados a partir do anterior. Deixe em branco os que não serão usados.</p>
    <div class="grid grid-cols-2 md:grid-cols-5 gap-3">
      <% field.step_inputs.each_with_index do |minutes, index| %>
        <label class="flex flex-col gap-1 text-sm text-slate-700">
          FUP <%= index + 1 %>
          <%= number_field_tag 'follow_up[steps][]', minutes, min: 1, step: 1, placeholder: 'min' %>
        </label>
      <% end %>
    </div>
  </div>
  <div class="flex flex-col gap-3 pt-4 border-t border-slate-200">
    <div class="flex items-center justify-between">
      <span class="text-sm text-slate-700">Encerramento por falta de resposta</span>
      <%= hidden_field_tag 'follow_up[end_flow][enabled]', '0', id: nil %>
      <%= check_box_tag 'follow_up[end_flow][enabled]', '1', field.end_flow['enabled'], class: 'h-4 w-4 rounded border-slate-300 text-violet-600 focus:ring-violet-600' %>
    </div>
    <label class="flex flex-col gap-1 text-sm text-slate-700">
      Tempo de espera após o último FUP (minutos)
      <%= number_field_tag 'follow_up[end_flow][wait_minutes]', field.end_flow['wait_minutes'], min: 1, step: 1 %>
    </label>
    <label class="flex flex-col gap-1 text-sm text-slate-700">
      Nota de resumo para o time (use @resumo@ para o resumo da IA)
      <%= text_area_tag 'follow_up[end_flow][summary_message]', field.end_flow['summary_message'], rows: 3 %>
    </label>
    <label class="flex flex-col gap-1 text-sm text-slate-700">
      Mensagem ao paciente antes da escala
      <%= text_area_tag 'follow_up[end_flow][escalation_message]', field.end_flow['escalation_message'], rows: 3 %>
    </label>
  </div>
</div>

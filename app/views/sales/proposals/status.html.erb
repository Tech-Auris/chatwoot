<%
  # The bar shows the step that is still open. Onboarding only becomes
  # current after the tokens step is done — either the card was saved on
  # Stripe or the seller waived it — so the marker and the CTA underneath
  # agree on what the customer still has to do; showing "5. Onboarding"
  # with a "Cadastrar cartão dos tokens" button below it used to read as
  # a broken screen.
  current_step =
    if @proposal.converted? && @proposal.token_card_settled? then :onboarding
    elsif @proposal.paid? || @proposal.converted? then :tokens
    else :payment
    end
%>
<%= render 'steps', current: current_step %>

<div class="bg-white rounded-lg shadow p-6">
  <h1 class="text-lg font-medium text-slate-900">Acompanhamento</h1>

  <% if @proposal.converted? %>
    <p class="text-sm text-slate-600 mt-2">
      Seu acesso foi criado e o time já está preparando a implantação. Vamos
      falar com você pelo WhatsApp <strong><%= @proposal.prospect_phone %></strong>.
    </p>

    <% if @proposal.token_card_waived_at.present? %>
      <p class="text-sm text-slate-600 mt-2">
        Combinado com o seu consultor: o consumo de tokens será cobrado por
        fatura, sem cartão cadastrado.
      </p>
    <% end %>
  <% elsif @proposal.paid? %>
    <p class="text-sm text-slate-600 mt-2">
      Pagamento confirmado. Estamos criando o seu acesso — em instantes o
      onboarding começa.
    </p>
  <% elsif @proposal.payment_method_pix? %>
    <p class="text-sm text-slate-600 mt-2">
      Aguardando a confirmação do seu PIX. Assim que o pagamento for
      identificado, criamos o acesso e seguimos para o onboarding.
    </p>

    <%# Still here, and not only on the page right after the choice: somebody
        who closed the tab before paying comes back to this one. %>
    <%= render 'pix_instructions' %>
  <% elsif @proposal.payment_method_boleto? && @proposal.asaas_invoice_url.present? %>
    <p class="text-sm text-slate-600 mt-2">
      Aguardando a confirmação do boleto. Se ainda não pagou ou fechou a aba,
      reabra o boleto abaixo para ver o código de barras e o PDF.
    </p>

    <%= link_to 'Abrir o boleto',
          @proposal.asaas_invoice_url,
          target: '_blank', rel: 'noopener noreferrer',
          class: 'mt-4 block w-full text-center px-3 py-2 rounded border border-slate-200 text-slate-700 text-sm' %>
  <% else %>
    <p class="text-sm text-slate-600 mt-2">
      Aguardando a confirmação do pagamento.
    </p>
  <% end %>

  <% if !@proposal.token_card_settled? && (@proposal.paid? || @proposal.converted?) %>
    <%= link_to 'Cadastrar cartão dos tokens', sales_proposal_tokens_path(@proposal.public_token),
          class: 'mt-5 block w-full text-center px-3 py-2 rounded bg-woot-500 text-white text-sm' %>
  <% end %>

  <%= render 'change_payment' %>

  <div class="mt-5 pt-4 border-t border-slate-100 flex justify-between text-sm text-slate-700">
    <span>Total contratado</span>
    <span><%= proposal_amount(@proposal.total_amount) %></span>
  </div>
</div>

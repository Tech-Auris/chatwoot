<%# Everything the prospect needs to pay: who is being paid, the code, and the
    reminder that the amount is typed by them — the company code is static and
    carries no value. %>
<% pix_code = pix_payload(@proposal) %>
<div class="mt-5 rounded-lg border border-slate-200 p-4">
  <h2 class="text-sm font-medium text-slate-900">Pague por PIX</h2>

  <div class="mt-3 text-sm text-slate-700 leading-relaxed">
    <p class="font-medium">AURIS AI SERVIÇOS DE TECNOLOGIA LTDA</p>
    <p class="mt-2">61.818.867/0001-43</p>
    <p class="mt-2">
      Alameda Rio Negro, nº 503, Andar 23, Conjunto 2301<br />
      Alphaville, Barueri SP 06.454-000<br />
      Brasil
    </p>
  </div>

  <% if pix_code.present? %>
    <div class="mt-4 flex justify-between text-sm">
      <span class="text-slate-600">Valor a pagar</span>
      <span class="font-medium text-slate-900"><%= proposal_amount(@proposal.total_amount) %></span>
    </div>

    <p class="mt-3 text-sm font-medium text-slate-900">
      Confira o valor quando for pagar
    </p>

    <div class="mt-3 flex justify-center">
      <%= image_tag pix_qr_code(pix_code), alt: 'QR Code do PIX', class: 'w-56 h-56' %>
    </div>

    <p class="mt-3 text-xs text-slate-500">
      Prefere copiar e colar? Use o código abaixo no aplicativo do seu banco.
    </p>
    <textarea readonly rows="3"
      class="mt-2 w-full border border-slate-200 rounded px-3 py-2 text-xs text-slate-600 break-all"
      onclick="this.select()"><%= pix_code %></textarea>
  <% else %>
    <p class="mt-4 text-sm text-slate-600">
      Nosso time envia o código do PIX no seu WhatsApp
      <strong><%= @proposal.prospect_phone %></strong>.
    </p>
  <% end %>
</div>

<%= render 'steps', current: :payment %>

<div class="bg-white rounded-lg shadow p-6">
  <% if @proposal.payment_method_pix? %>
    <h1 class="text-lg font-medium text-slate-900">Quase lá</h1>
    <p class="text-sm text-slate-600 mt-2">
      Recebemos o seu aceite. Faça o PIX de
      <strong><%= proposal_amount(@proposal.total_amount) %></strong> com os
      dados abaixo.
    </p>

    <%= render 'pix_instructions' %>

    <p class="text-sm text-slate-600 mt-4">
      Assim que o pagamento for confirmado, liberamos o acesso e o onboarding
      começa. Você pode voltar a esta página a qualquer momento para acompanhar.
    </p>
  <% else %>
    <h1 class="text-lg font-medium text-slate-900">Pagamento recebido</h1>
    <p class="text-sm text-slate-600 mt-2">
      Obrigado! Vamos preparar o seu acesso e o onboarding começa em seguida.
    </p>
  <% end %>

  <%= link_to 'Continuar', sales_proposal_tokens_path(@proposal.public_token),
        class: 'mt-5 block w-full text-center px-3 py-2 rounded bg-woot-500 text-white text-sm' %>

  <div class="mt-4 pt-4 border-t border-slate-100 flex justify-between text-sm text-slate-700">
    <span>Total contratado</span>
    <span><%= proposal_amount(@proposal.total_amount) %></span>
  </div>
</div>

<%# Plan lines and totals, shared by the pages that recap the proposal. %>
<ul class="mt-5 divide-y divide-slate-100">
  <% @items.each do |item| %>
    <li class="py-2 flex justify-between text-sm">
      <span class="text-slate-700">
        <%= item.name %>
        <span class="text-slate-400 ml-1">(<%= proposal_item_period(item, @proposal) %>)</span>
        <% if item.quantity > 1 %><span class="text-slate-400">× <%= item.quantity %></span><% end %>
      </span>
      <span class="text-slate-700"><%= proposal_amount(item.total_amount) %></span>
    </li>
  <% end %>
</ul>
<div class="mt-3 pt-3 border-t border-slate-100 text-sm">
  <div class="flex justify-between text-slate-600">
    <span>Subtotal</span>
    <span><%= proposal_amount(@proposal.subtotal_amount) %></span>
  </div>
  <% if @proposal.effective_discount_amount.positive? %>
    <div class="flex justify-between text-green-700 mt-1">
      <span>Desconto<%= " (#{@proposal.effective_discount_summary})" if @proposal.effective_discount_summary %></span>
      <span class="whitespace-nowrap">− <%= proposal_amount(@proposal.effective_discount_amount) %></span>
    </div>
  <% end %>
  <div class="flex justify-between text-slate-900 font-medium mt-2 text-base">
    <span>Total</span>
    <span><%= proposal_amount(@proposal.effective_total_amount) %></span>
  </div>
</div>

<%= render 'steps', current: :sign %>

<div class="bg-white rounded-lg shadow p-6">
  <h1 class="text-lg font-medium text-slate-900">Termos de uso da Plataforma Auris</h1>
  <p class="mt-1 text-sm text-slate-500">Leia os termos de uso até o final e dê o aceite para avançar.</p>

  <% if @proposal.reservation_active? %>
    <p class="mt-2 text-sm text-green-700">Condições reservadas até <%= proposal_datetime(@proposal.reserved_until) %>.</p>
  <% elsif @proposal.reserved_until.present? %>
    <p class="mt-2 text-sm text-yellow-700">A reserva venceu — os valores abaixo são os de tabela.</p>
  <% end %>

  <% if local_assigns[:error].present? %>
    <p class="mt-4 text-sm text-red-600"><%= error %></p>
  <% end %>

  <%= render 'summary' %>

  <%= form_with url: sales_proposal_accept_terms_path(@proposal.public_token), method: :post, class: 'mt-6 flex flex-col gap-4' do |f| %>
    <% if @terms_error.present? %>
      <p class="text-sm text-red-600"><%= @terms_error %></p>
    <% else %>
      <%= hidden_field_tag :terms_version_id, @terms_version.id %>
      <div
        id="terms-box"
        class="h-72 overflow-y-auto border border-slate-200 rounded p-3 text-xs leading-relaxed text-slate-600 prose-sm"
      ><%= sanitize @terms_version.content,
            tags: Sales::TermsFetcherService::ALLOWED_TAGS,
            attributes: Sales::TermsFetcherService::ALLOWED_ATTRIBUTES %></div>
      <p id="terms-hint" class="-mt-3 text-xs text-slate-500" aria-live="polite">Role até o fim para liberar o aceite.</p>

      <label class="flex items-start gap-2 text-sm text-slate-700">
        <%= check_box_tag :accept_terms, '1', false, class: 'mt-1', disabled: true, id: 'accept-terms' %>
        <span>
          Li e aceito os Termos de Uso da Plataforma Auris
          <a href="<%= @terms_version.source_url %>" target="_blank" rel="noopener noreferrer" class="underline text-slate-500">(abrir em outra aba)</a>.
        </span>
      </label>
    <% end %>

    <%= f.submit 'Assinar Termos de Uso e continuar', disabled: @terms_error.present?,
          class: 'w-full px-3 py-2 rounded bg-woot-500 text-white text-sm cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed' %>
  <% end %>
</div>

<%= render 'terms_scroll_script' %>

<%= render 'steps', current: :sign %>

<div class="bg-white rounded-lg shadow p-6">
  <% if @proposal.reservation_active? %>
    <h2 class="text-base font-medium text-green-700 mb-1">
      ✅ Condição reservada com sucesso!
    </h2>
  <% end %>

  <h1 class="text-lg font-medium text-slate-900">
    Proposta para <%= @proposal.prospect_name %>
  </h1>

  <% if @proposal.reservation_active? %>
    <p class="mt-1 text-sm text-green-700">
      Reservado até
      <strong><%= l(@proposal.reserved_until.to_date, format: '%d/%m/%Y') %></strong>.
    </p>
  <% elsif @proposal.reserved_until.present? %>
    <p class="mt-1 text-sm text-yellow-700">
      A reserva venceu em <%= proposal_datetime(@proposal.reserved_until) %>.
      Fale com o seu consultor para renovar as condições.
    </p>
  <% end %>

  <ul class="mt-5 divide-y divide-slate-100">
    <% @items.each do |item| %>
      <li class="py-2 flex justify-between text-sm">
        <span class="text-slate-700">
          <%= item.name %>
          <span class="text-slate-400 ml-1">
            (<%= proposal_item_period(item, @proposal) %>)
          </span>
          <% if item.quantity > 1 %>
            <span class="text-slate-400">× <%= item.quantity %></span>
          <% end %>
        </span>
        <span class="text-slate-700">
          <%= proposal_amount(item.total_amount) %>
        </span>
      </li>
    <% end %>
  </ul>

  <div class="mt-4 pt-4 border-t border-slate-100 text-sm">
    <div class="flex justify-between text-slate-600">
      <span>Subtotal</span>
      <span><%= proposal_amount(@proposal.subtotal_amount) %></span>
    </div>
    <% if @proposal.discount_amount.positive? %>
      <div class="flex justify-between text-green-700 mt-1">
        <span>Desconto<%= " (#{@proposal.discount_summary})" if @proposal.discount_summary %></span>
        <span>− <%= proposal_amount(@proposal.discount_amount) %></span>
      </div>
    <% end %>
    <div class="flex justify-between text-slate-900 font-medium mt-2 text-base">
      <span>Total</span>
      <span><%= proposal_amount(@proposal.total_amount) %></span>
    </div>

    <%# For semiannual/annual plans, the equivalent card instalment gives the
        prospect a monthly-ish reading of the total — the actual split still
        happens at checkout. %>
    <% if proposal_installment_hint(@proposal).present? %>
      <p class="mt-2 text-xs text-slate-500 text-right">
        <%= proposal_installment_hint(@proposal) %>
      </p>
    <% end %>

    <%= render 'monthly_note' %>
  </div>

  <% if @proposal.reservation_active? %>
    <div class="mt-6 rounded bg-green-50 px-4 py-3" data-testid="countdown">
      <% if @proposal.discount_amount.positive? %>
        <p class="text-sm text-green-800">
          Você garantiu
          <strong><%= proposal_amount(@proposal.discount_amount) %></strong>
          de desconto.
        </p>
      <% end %>
      <p class="text-sm text-green-800<%= ' mt-1' if @proposal.discount_amount.positive? %>">
        Essa condição ficará disponível por
        <strong><%= proposal_time_left(@proposal.reserved_until) %></strong>.
      </p>
    </div>
  <% end %>

  <% if @proposal.reservation_active? %>
    <p class="mt-6 text-xs text-slate-600 text-center">
      Quer concluir a contratação agora?<br>
      Você pode prosseguir para a assinatura agora ou retornar até o encerramento da reserva.
    </p>
  <% end %>

  <%= link_to 'Prosseguir para assinatura', sales_proposal_checkout_path(@proposal.public_token),
        class: 'mt-4 block w-full text-center px-3 py-2 rounded bg-woot-500 text-white text-sm' %>
</div>

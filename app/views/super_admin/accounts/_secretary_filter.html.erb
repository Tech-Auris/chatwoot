<%# Pickers above the Accounts grid: secretary version, AI provider and LLM.
    Each one drives its own collection filter (`secretaria:`, `provedor:`,
    `llm:`) inside the search, so they combine and survive sorting and paging. %>
<% search = params[:search].to_s %>
<% current = search[/(?:\A|\s)secretaria:(\S*)/, 1] %>
<% current_provider = search[/(?:\A|\s)provedor:(\S*)/, 1] %>
<% current_model = search[/(?:\A|\s)llm:(\S*)/, 1] %>
<script>
  // Swaps one `name:value` token of the search, keeping the other filters.
  // `clear` lists tokens to drop too (the LLM depends on the provider).
  function setAccountFilter(name, value, clear) {
    var drop = [name].concat(clear || []);
    var params = new URLSearchParams(window.location.search);
    var tokens = (params.get('search') || '').split(/\s+/).filter(function (token) {
      return token && !drop.some(function (key) { return token.indexOf(key + ':') === 0; });
    });
    if (value) tokens.push(name + ':' + value);
    window.location.href = tokens.length ? '?search=' + encodeURIComponent(tokens.join(' ')) : '?';
  }
</script>
<div class="flex items-center bg-gray-100 border-0 rounded-md shadow-none relative w-[220px] ml-2">
  <select id="secretary-filter-select"
          aria-label="Versão da secretária"
          class="appearance-none bg-transparent border-0 text-gray-700 cursor-pointer text-sm h-10 w-full px-3 focus:outline-none"
          onchange="setAccountFilter('secretaria', this.value)">
    <option value="">Versão da secretária: todas</option>
    <option value="nenhuma" <%= 'selected' if current == 'nenhuma' %>>Sem secretária</option>
    <% SecretaryVersion.ordered.each do |version| %>
      <option value="<%= version.id %>" <%= 'selected' if current == version.id.to_s %>><%= version.name %></option>
    <% end %>
  </select>
</div>
<div class="flex items-center bg-gray-100 border-0 rounded-md shadow-none relative w-[180px] ml-2">
  <select id="ai-provider-filter-select"
          aria-label="Provider"
          class="appearance-none bg-transparent border-0 text-gray-700 cursor-pointer text-sm h-10 w-full px-3 focus:outline-none"
          onchange="setAccountFilter('provedor', this.value, ['llm'])">
    <option value="">Provider: todos</option>
    <% AiProvider.order(:name).each do |provider| %>
      <option value="<%= provider.id %>" <%= 'selected' if current_provider == provider.id.to_s %>><%= provider.name %></option>
    <% end %>
  </select>
</div>
<div class="flex items-center bg-gray-100 border-0 rounded-md shadow-none relative w-[220px] ml-2">
  <select id="ai-model-filter-select"
          aria-label="LLM"
          class="appearance-none bg-transparent border-0 text-gray-700 cursor-pointer text-sm h-10 w-full px-3 focus:outline-none"
          onchange="setAccountFilter('llm', this.value)">
    <option value="">LLM: todos</option>
    <option value="nenhum" <%= 'selected' if current_model == 'nenhum' %>>Sem LLM</option>
    <% models = AiModel.includes(:ai_provider).order(:name) %>
    <% models = models.where(ai_provider_id: current_provider) if current_provider.present? %>
    <% models.each do |model| %>
      <option value="<%= model.id %>" <%= 'selected' if current_model == model.id.to_s %>><%= "#{model.ai_provider.name} - #{model.name}" %></option>
    <% end %>
  </select>
</div>

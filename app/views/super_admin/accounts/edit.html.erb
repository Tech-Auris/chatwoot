<%# Administrate's default edit page plus the "Secretária" section, which
    saves on its own through Super Admin → account → secretary. %>
<% content_for(:title) { t("administrate.actions.edit_resource", name: page.page_title) } %>

<header class="main-content__header">
  <h1 class="main-content__page-title">
    <%= content_for(:title) %>
  </h1>

  <div>
    <%= link_to(
      t("administrate.actions.show_resource", name: page.page_title),
      [namespace, page.resource],
      class: "button",
    ) if accessible_action?(page.resource, :show) %>
  </div>
</header>

<section class="main-content__body">
  <%= render "form", page: page %>
</section>

<section class="main-content__body">
  <hr/>
  <%= render_vue_component('AccountSecretary', {
    url: super_admin_account_secretary_url(page.resource, format: :json),
    regenerate_url: regenerate_secret_super_admin_account_secretary_url(page.resource, format: :json)
  }) %>
</section>

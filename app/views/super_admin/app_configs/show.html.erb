<% content_for(:title) do %>
  Configure Settings - <%= @config.titleize %>
<% end %>

<header class="main-content__header" role="banner">
  <h1 class="main-content__page-title" id="page-title">
    <%= content_for(:title) %>
  </h1>
</header>

<style>
.eye-icon.eye-hide path {
  d: path('M3 3l18 18M10.5 10.677a2 2 0 002.823 2.823M7.362 7.561C5.68 8.74 4.279 10.42 3 12c1.889 2.991 5.282 6 9 6 1.55 0 3.043-.523 4.395-1.35M12 6c4.008 0 6.701 3.009 9 6a15.66 15.66 0 01-1.078 1.5');
}
</style>

<section class="main-content__body">
  <%= form_with url: super_admin_app_config_url(config: @config) , method: :post do |form| %>
    <% ungrouped_config_keys.each do |key| %>
      <div class="flex mb-8">
        <div class="field-unit__label">
          <%= form.label "app_config[#{key}]", @installation_configs[key]&.dig('display_title') || key %>
        </div>
        <div class="-mt-2 field-unit__field ">
          <%= render 'config_input', form: form, key: key %>
        </div>
      </div>
    <% end %>
    <%# Related settings in one bordered block, as on the account edit page. %>
    <% config_groups.each do |title, keys| %>
      <div class="flex mb-8">
        <div class="field-unit__label">
          <%= form.label "group_#{title.parameterize}", title %>
        </div>
        <div class="field-unit__field flex flex-col gap-6 p-4 bg-white rounded-lg shadow-sm outline outline-1 outline-n-container">
          <% keys.each do |key| %>
            <div>
              <%= form.label "app_config[#{key}]", @installation_configs[key]&.dig('display_title') || key, class: 'text-sm text-slate-700' %>
              <%= render 'config_input', form: form, key: key %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
    <div class="form-actions">
      <%= form.submit "Submit" %>
    </div>
  <% end %>
</section>

<% if @config == 'clickup' %>
  <%= render 'clickup_webhook_panel' %>
<% end %>

<% if @config == 'stripe' %>
  <%= render 'stripe_connection_panel' %>
<% end %>

<% if @config == 'autentique' %>
  <%= render 'autentique_connection_panel' %>
<% end %>

<% content_for :javascript do %>
  <script>
  document.addEventListener('DOMContentLoaded', () => {
    // Settings → Commercial: the inbox list only offers the inboxes of the
    // account picked above it.
    const accountSelect = document.getElementById('commercial_account_select');
    const inboxSelect = document.getElementById('commercial_inbox_select');
    if (accountSelect && inboxSelect) {
      const filterInboxes = () => {
        const options = Array.from(inboxSelect.options);
        options.forEach(option => {
          option.hidden = option.dataset.accountId !== accountSelect.value;
        });
        if (inboxSelect.selectedOptions[0]?.hidden) {
          const first = options.find(option => !option.hidden);
          inboxSelect.value = first ? first.value : '';
        }
      };
      accountSelect.addEventListener('change', filterInboxes);
      filterInboxes();
    }

    document.querySelectorAll('.toggle-password').forEach(button => {
      button.addEventListener('click', () => {
        const targetId = button.dataset.target;
        const input = document.getElementById(targetId);
        const type = input.type === 'password' ? 'text' : 'password';
        input.type = type;

        // Toggle icon
        const svg = button.querySelector('.eye-icon');
        if (type === 'password') {
          svg.classList.remove('eye-hide')
        } else {
          svg.classList.add('eye-hide')
        }
      });
    });
  });
  </script>
<% end %>

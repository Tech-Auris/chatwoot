<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <title>SuperAdmin | <%= ENV.fetch('FRONTEND_URL', 'AurisChat').sub(%r{https?://}, '') %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <%= csrf_meta_tags %>
    <%= vite_client_tag %>
    <%= vite_javascript_tag 'superadmin' %>
  </head>
  <body class="antialiased bg-woot-25 min-h-screen">
    <main class="min-h-screen w-full flex flex-col items-center py-16 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-6">
        <img src="/brand-assets/logo.svg" alt="AurisChat" class="h-8 w-auto">
        <span class="text-3xl font-medium text-slate-900">AurisChat</span>
      </div>

      <h1 class="text-3xl font-medium text-slate-900 mb-8">Entrar</h1>

      <section class="bg-white shadow sm:mx-auto sm:w-full sm:max-w-lg p-11 sm:shadow-lg sm:rounded-lg">
        <div class="text-center mb-6">
          <div class="inline-flex items-center justify-center size-14 bg-slate-50 border border-slate-200 rounded-full mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 text-slate-500">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" />
            </svg>
          </div>
          <h2 class="text-2xl font-semibold text-slate-900">
            Autenticação em Dois Fatores
          </h2>
          <p class="text-sm text-slate-500 mt-2">
            Informe o código de verificação para continuar
          </p>
        </div>

        <%= form_with url: super_admin_sessions_mfa_challenge_path, method: :post, local: true, id: 'mfa-form' do %>
          <div class="flex rounded-lg bg-slate-100 p-1 mb-6" role="tablist">
            <button type="button" data-method="otp"
                    class="mfa-tab flex-1 py-2 px-4 text-sm font-medium rounded-md transition-colors bg-white shadow-sm text-slate-900">
              Aplicativo<br>Autenticador
            </button>
            <button type="button" data-method="backup"
                    class="mfa-tab flex-1 py-2 px-4 text-sm font-medium rounded-md transition-colors text-slate-500">
              Código de<br>Recuperação
            </button>
          </div>

          <div id="otp-panel" class="mb-4">
            <label class="block text-sm font-medium text-slate-900 mb-2">
              Insira o código de 6 dígitos do seu aplicativo autenticador
            </label>
            <div class="flex justify-between gap-2">
              <% 6.times do |i| %>
                <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]" autocomplete="one-time-code"
                       data-otp-index="<%= i %>"
                       class="otp-digit w-12 h-12 text-center text-lg font-semibold border-2 border-slate-200 hover:border-slate-300 rounded-lg focus:border-woot-500 focus:outline-none bg-slate-50 text-slate-900">
              <% end %>
            </div>
            <input type="hidden" name="otp_code" id="otp_code_hidden">
          </div>

          <div id="backup-panel" class="mb-4 hidden">
            <label for="backup_code" class="block text-sm font-medium text-slate-900 mb-2">
              Insira um dos seus códigos de recuperação
            </label>
            <input type="text" id="backup_code" name="backup_code" autocomplete="off" placeholder="000000"
                   class="block w-full rounded-md border-0 px-3 py-3 shadow-sm ring-1 ring-inset ring-slate-200 text-slate-900 placeholder:text-slate-400 focus:ring-2 focus:ring-inset focus:ring-woot-500 sm:text-sm sm:leading-6 outline-none">
          </div>

          <% if flash[:error].present? %>
            <div class="p-3 bg-red-50 border border-red-200 rounded-lg mb-4">
              <p class="text-sm text-red-700"><%= flash[:error] %></p>
            </div>
          <% end %>

          <button type="submit" id="mfa-submit"
                  class="w-full rounded-md bg-woot-500 hover:bg-woot-600 py-3 px-3 text-base font-medium text-white shadow-sm disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer">
            Verificar
          </button>

          <div class="text-center flex flex-col gap-2 pt-4">
            <button type="button" id="mfa-toggle" class="text-sm text-woot-500 hover:underline bg-transparent border-0 cursor-pointer">
              Tentar outro método de verificação
            </button>
            <%= button_to 'Cancelar e voltar para o login', super_admin_logout_path, method: :get,
                  class: 'text-sm text-slate-500 hover:underline bg-transparent border-0 cursor-pointer' %>
          </div>
        <% end %>
      </section>

      <div class="mt-6 text-center">
        <p class="text-sm text-slate-500">Está com dificuldade para entrar?</p>
        <p class="text-sm text-woot-500 mt-1">Saiba mais sobre o 2FA</p>
      </div>
    </main>

    <script>
      (function () {
        var digits = Array.prototype.slice.call(document.querySelectorAll('.otp-digit'));
        var hidden = document.getElementById('otp_code_hidden');
        var submit = document.getElementById('mfa-submit');
        var backupInput = document.getElementById('backup_code');
        var otpPanel = document.getElementById('otp-panel');
        var backupPanel = document.getElementById('backup-panel');
        var tabs = document.querySelectorAll('.mfa-tab');
        var toggleLink = document.getElementById('mfa-toggle');
        var method = 'otp';

        function syncOtp() {
          hidden.value = digits.map(function (d) { return d.value; }).join('');
        }
        function updateSubmitState() {
          if (method === 'otp') {
            submit.disabled = hidden.value.length !== 6;
          } else {
            submit.disabled = backupInput.value.trim().length === 0;
          }
        }
        function setMethod(next) {
          method = next;
          tabs.forEach(function (tab) {
            var active = tab.dataset.method === next;
            tab.classList.toggle('bg-white', active);
            tab.classList.toggle('shadow-sm', active);
            tab.classList.toggle('text-slate-900', active);
            tab.classList.toggle('text-slate-500', !active);
          });
          otpPanel.classList.toggle('hidden', next !== 'otp');
          backupPanel.classList.toggle('hidden', next !== 'backup');
          if (next === 'otp') {
            backupInput.value = '';
            if (digits[0]) digits[0].focus();
          } else {
            digits.forEach(function (d) { d.value = ''; });
            hidden.value = '';
            backupInput.focus();
          }
          updateSubmitState();
        }

        digits.forEach(function (input, i) {
          input.addEventListener('input', function () {
            input.value = input.value.replace(/\D/g, '').slice(0, 1);
            syncOtp();
            updateSubmitState();
            if (input.value && i < digits.length - 1) digits[i + 1].focus();
          });
          input.addEventListener('keydown', function (e) {
            if (e.key === 'Backspace' && !input.value && i > 0) {
              digits[i - 1].focus();
              digits[i - 1].value = '';
              syncOtp();
              updateSubmitState();
              e.preventDefault();
            } else if (e.key === 'ArrowLeft' && i > 0) {
              digits[i - 1].focus(); e.preventDefault();
            } else if (e.key === 'ArrowRight' && i < digits.length - 1) {
              digits[i + 1].focus(); e.preventDefault();
            }
          });
          input.addEventListener('paste', function (e) {
            var text = (e.clipboardData || window.clipboardData).getData('text').replace(/\D/g, '').slice(0, 6);
            if (!text) return;
            e.preventDefault();
            for (var k = 0; k < digits.length; k++) digits[k].value = text[k] || '';
            syncOtp();
            updateSubmitState();
            var lastFilled = Math.min(text.length, digits.length) - 1;
            if (lastFilled >= 0) digits[Math.min(lastFilled + 1, digits.length - 1)].focus();
          });
        });

        backupInput.addEventListener('input', updateSubmitState);
        tabs.forEach(function (tab) {
          tab.addEventListener('click', function () { setMethod(tab.dataset.method); });
        });
        toggleLink.addEventListener('click', function () {
          setMethod(method === 'otp' ? 'backup' : 'otp');
        });

        setMethod('otp');
        if (digits[0]) digits[0].focus();
      })();
    </script>
  </body>
</html>
